
---->  Wireshark & Npcap/libpcap Deployment Guide <----

# Step 1: Update system packages
sudo apt update && sudo apt upgrade -y

# Step 2: Install Wireshark and TShark CLI utility sudo apt install -y wireshark tshark libpcap-dev

# Step 3: Grant packet capture capabilities to non-root users sudo dpkg-reconfigure wireshark-common
# (Select in the ncurses interface to enable non-superuser capture)

# Step 4: Add the current user to the wireshark group sudo usermod -aG wireshark $USER

# Step 5: Refresh user group membership and verify capture interfaces newgrp wireshark
tshark -D

