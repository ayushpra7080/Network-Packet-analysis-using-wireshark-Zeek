# SCENARIO 4: ICMP VOLUMETRIC FLOOD SIMULATION
# ========================================================
# Start capture for ICMP protocol
tshark -i lo -f "icmp" -w icmp_flood_test.pcap & DOS_PID=$!

# Send 100 oversized ICMP packets with an aggressive 10ms interval # -s 8192 : 8KB payload (forces multi-fragment IP decomposition)
# -i 0.01 : 10 millisecond interval # -c 100 : Transmit 100 packets
sudo ping -s 8192 -i 0.01 -c 100 127.0.0.1

# Stop capture sleep 1
kill -2 $DOS_PID

