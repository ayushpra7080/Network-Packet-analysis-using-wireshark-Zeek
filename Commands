[

# File: detect_cleartext_creds.zeek @load base/protocols/http
module SecurityAudit;

export {
redef enum Notice::Type += { Cleartext_Credential_Exfiltration
};
}

event http_entity_data(c: connection, is_orig: bool, length: count, data: string)
{
if ( is_orig && ( /uname=/ in data || /password=/ in data || /pass=/ in data ) )
{
NOTICE([$note=Cleartext_Credential_Exfiltration,
$msg=fmt("Unencrypted credentials detected in HTTP POST from %s to %s", c$id$orig_h, c$id$resp_h),
$conn=c,
$sub=data]);
}
}

]
