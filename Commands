# SCENARIO 3: NMAP STEALTH SYN RECONNAISSANCE SCAN
# ========================================================
# Start capture on loopback interface tshark -i lo -w portscan_attack.pcap & SCAN_PID=$!

# Execute Nmap SYN scan across service ports (20 to 110) # -sS : SYN Stealth scan
# -p 20-110 : Scan port range 20 through 110 # -T4 : Aggressive timing template
# -n : Disable DNS resolution to avoid extraneous packets sudo nmap -sS -p 20-110 -T4 -n 127.0.0.1 -oN nmap_report.txt

# Terminate capture sleep 1
kill -2 $SCAN_PID

